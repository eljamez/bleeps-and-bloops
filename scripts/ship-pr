#!/usr/bin/env python3
"""ship-pr tick. Stub. Prints the step and does not merge.

The procedure is specified in docs/ship-pr.md. This command refuses every
merge, including --dry-run, until that procedure is implemented.
"""

from __future__ import annotations

import json
import sys

BODY = {
    "phase": "unimplemented",
    "exit": {"done": False},
    "done": [],
    "remaining": ["ci", "reviews", "decisions", "merge", "health", "friction"],
    "step": {
        "id": "unimplemented",
        "summary": "scripts/ship-pr does not merge. The procedure is not built. See docs/ship-pr.md.",
    },
    "wouldMerge": False,
}


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help"}:
        print(
            "usage: ship-pr tick --pr URL --risk low|medium|high [--dry-run] [--decide ID --reason TEXT]",
            file=sys.stderr,
        )
        return 0 if argv and argv[0] in {"-h", "--help"} else 2
    if argv[0] != "tick":
        print("ship-pr: only tick is defined, and it is not implemented", file=sys.stderr)
        return 2
    json.dump(BODY, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
