#!/usr/bin/env python3
"""Opt-in Orca Bots runtime. print shows commands. check keeps the repo honest.

print does not run orca. Nothing here creates a bot. Orca creates a bot
only when you press Create bot on the card `orca bot create --offer` shows,
and that card has to be requested from a bot's chat (or you create the
first bot in the app). A group has no documented create command.

runtime in orca.project.yaml is issue-command (default) or bots.
issue-command is today's issueCommand prompt. bots is the group.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import re
import sys
from pathlib import Path

RUNTIMES = ("issue-command", "bots")
# Echo stays a fresh worker. These are the bots in the one group.
BOTS = (
    ("bleeps", "Coordinates the crew in one group and does not do their jobs."),
    ("beep", "Plans the ticket into spec.md and tasks.md and writes no product code."),
    ("buzz", "Implements the tasks in a worker worktree and does not certify the result."),
    ("blip", "Owns the suites and runs the fix loop while the suite is red."),
    ("chip", "Scouts on a schedule, files bleeps:found issues, and does not merge."),
    ("bloops", "Merges through scripts/merge-pr only when the owner asks, then proposes improvements as pull requests."),
)
LOOK_OFF = ("beep", "buzz", "blip", "bloops")
LOOK_ON = ("bleeps", "chip")
# Code work is a worker. Bloops' merge is the script; the worker is reflection.
WORKER_ROLES = ("beep", "buzz", "blip", "echo", "chip", "bloops")
# Substrings every SOUL.md must contain. The writer never certifies, and the gates stay the scripts.
SHARED_NEEDLES = (
    "The writer never certifies.",
    "Nothing merges while the suite is red.",
    "develop",
    "Never main.",
    "James",
)
ROLE_NEEDLES = {
    "bleeps": ("bot:beep", "Echo", "fresh", "bleeps:go", "scripts/merge-pr"),
    "beep": ("scripts/kick-off", "no product code", "bot:buzz"),
    "buzz": ("verify.md", "bot:blip", "scripts/providers"),
    "blip": ("scripts/fix-loop", "verify.md"),
    "chip": ("scripts/bleeps-scout", "bleeps:found", "bot:bleeps"),
    "bloops": ("scripts/merge-pr", "only when James says so", "MEMORY.md", "repo skills"),
}
FRONTMATTER = re.compile(r"^---\n(.*?)\n---", re.S)


def load_script(name: str, filename: str):
    path = Path(__file__).resolve().parent / filename
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    if spec is None:
        raise SystemExit(f"cannot load scripts/{filename}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def bleeps():
    return load_script("bleeps_from_bots", "bleeps")


def providers():
    return load_script("providers_from_bots", "providers")


def runtime_choice(project: dict[str, str]) -> str:
    value = project.get("runtime", "issue-command")
    if value not in RUNTIMES:
        raise SystemExit(
            f"runtime must be issue-command or bots, got {value!r}. "
            "issue-command is the default prompt. bots is the optional group."
        )
    return value


def offer_lines() -> list[str]:
    return [
        f"orca bot create --offer --name {name} --purpose {json.dumps(purpose)}"
        for name, purpose in BOTS
    ]


def look_lines() -> list[str]:
    lines = [f"orca bot look-around set --bot {name} --off" for name in LOOK_OFF]
    lines.extend(
        f"orca bot look-around set --bot {name} --on --every every-4h --weekdays-only"
        for name in LOOK_ON
    )
    return lines


def send_line(name: str, subject: str, body: str) -> str:
    return (
        "orca orchestration send "
        f"--to bot:{name} --type handoff --subject {json.dumps(subject)} --body {json.dumps(body)}"
    )


def send_lines() -> list[str]:
    return [
        send_line("beep", "Plan", "Plan the ticket. Run scripts/kick-off or scripts/intake. Write no product code."),
        send_line("buzz", "Build", "Implement tasks.md in a worker worktree. Do not certify."),
        send_line("blip", "Test", "Run scripts/fix-loop. A red suite stays in this run."),
        send_line("bloops", "Merge", "Merge only through scripts/merge-pr, and only because the owner asked."),
        send_line("bleeps", "Issue", "A scout finding is ready. Run the crew. Do not start issueCommand."),
    ]


def go_automation() -> str:
    prompt = (
        "A GitHub issue was labelled bleeps:go. Run the crew on that issue. "
        "Do not start a second crew from issueCommand."
    )
    return (
        "orca automations create \\\n"
        "  --bot bleeps \\\n"
        '  --name "Bleeps go" \\\n'
        '  --on "github.labeled in=<owner/repo> label=bleeps:go" \\\n'
        f"  --prompt {json.dumps(prompt)} \\\n"
        "  --disabled"
    )


def chip_automation(root: Path, project: dict[str, str]) -> str:
    schedule = project.get("scout_schedule", "daily")
    when = project.get("scout_time", "09:00")
    provider, model = providers().automation_flags(root, "chip")
    script = Path(__file__).resolve().parent / "bleeps-scout"
    trigger = f"--trigger {schedule}"
    if schedule in {"daily", "weekdays", "weekly"}:
        trigger += f" --time {when}"
    prompt = (
        "Run scripts/bleeps-scout in this checkout. Do not scan a second way. "
        "It files bleeps:found issues. With runtime bots it hands each started "
        "issue to Bleeps and does not start an issueCommand worktree."
    )
    return (
        "orca automations create \\\n"
        "  --bot chip \\\n"
        '  --name "Bleeps scout" \\\n'
        f"  {trigger} \\\n"
        f"  --agent {provider} --model {model} --runs-in new \\\n"
        f"  --prompt {json.dumps(prompt)} \\\n"
        f"  --precheck {json.dumps(f'{script} precheck')} \\\n"
        "  --disabled"
    )


def worker_line(root: Path, role: str) -> str:
    provider, model = providers().automation_flags(root, role)
    return (
        "orca orchestration worker-start --task <taskId> "
        f"--worktree new-child --agent {provider} --model {model} --json"
    )


def handoff_argv(number: int) -> list[str]:
    return [
        "orca",
        "orchestration",
        "send",
        "--to",
        "bot:bleeps",
        "--type",
        "handoff",
        "--subject",
        f"Issue {number}",
        "--body",
        (
            f"Run the crew on GitHub issue {number}. "
            "Do not start a second crew from issueCommand."
        ),
    ]


def commands(root: Path, project: dict[str, str]) -> list[str]:
    found = [
        *offer_lines(),
        "orca bot connectors --offer github",
        "orca automations trigger-options --bot bleeps",
        *look_lines(),
        go_automation(),
        chip_automation(root, project),
        *send_lines(),
    ]
    found.extend(worker_line(root, role) for role in WORKER_ROLES)
    return found


def render(root: Path, project: dict[str, str]) -> str:
    mode = runtime_choice(project)
    blocks = [
        "These commands are not run. Copy the ones you want.",
        f"runtime: {mode}. The default is issue-command, which stays the issueCommand prompt.",
        "bots is optional. Set runtime: bots in orca.project.yaml after the group exists.",
        "",
        "Create. The first bot is made in the app: Bots, +, New bot or group, New bot.",
        "orca bot create --offer shows a card and creates nothing until you press Create bot.",
        "Run an offer from a bot's chat, not from a group room. A room does not show the card.",
        "After Create, paste bots/<name>/SOUL.md over the bot's SOUL.md. --purpose is only the first line.",
        *offer_lines(),
        "",
        "GitHub connector. Run from each bot's chat. Slack and Linear are not required.",
        "orca bot connectors --offer github",
        "",
        "Before every automations create, list the events this bot can hear:",
        "orca automations trigger-options --bot bleeps",
        "",
        "Permissions have no CLI flag. Orca's default is Full access. Do not leave it.",
        "Ask for approval on every bot that reads issues, mail, or messages.",
        "Accept edits on a worker session. The worker is the only place that writes the repo.",
        "",
        "Look around spends the agent's plan (every 4 hours on weekdays, unless you change it).",
        "Leave it on for Bleeps and Chip. Turn it off for the others. Run each line from that bot's chat.",
        *look_lines(),
        "",
        "Link this repository in each bot's settings so chats load .agents/skills.",
        "There is no documented CLI flag for that link. orca repo list shows the projects Orca knows.",
        "",
        "Group. No documented CLI creates one. In the app: Bots, +, New bot or group, New group.",
        "Name it Bleeps. Members: bleeps, beep, buzz, blip, chip, bloops. Echo is not a member.",
        "Host it on the computer `host` names. At least one member lives on that computer.",
        "Bots run only while that computer is awake and Orca is running. Pair a server you leave on",
        "when you want them reachable. Create each bot on that machine. A paired window cannot",
        "create a bot there yet.",
        "",
        "Label. Replace <owner/repo>. A label added by the owner's own GitHub login does not start",
        "the bot, because the bot acts as that login. Chip hands the issue across instead.",
        "Run trigger-options --bot bleeps first. Save this disabled, then enable it in Orca.",
        go_automation(),
        "",
        "Chip takes the scout schedule. Same scout_schedule and scout_time as bleeps-scout schedule.",
        "When runtime is bots, `python3 scripts/bleeps-scout schedule` prints this and not the provider form.",
        chip_automation(root, project),
        "",
        "Handoff order in the group. @Name in the room, or:",
        *send_lines(),
        "",
        "Models. python3 scripts/providers show <role> prints the provider and model.",
        "Pass them to the worker. Do not hardcode a model in the bot's memory.",
        *(worker_line(root, role) for role in WORKER_ROLES),
        "Echo's line is a fresh Claude Code worker per verify, not a bot and not a reused chat.",
        "Bloops merges with scripts/merge-pr and no model. The bloops worker is reflection only.",
        "",
        "Gates stay the scripts: intake, guardrails, fix-loop, orca-verify, verify, merge-pr, providers, check-site.",
        "Nothing merges while the suite is red. develop only. main is the owner's. Sign-off areas wait.",
    ]
    return "\n".join(blocks) + "\n"


def crew_bots(root: Path) -> list[str]:
    """Crew from decision 0010, lowercased, without Echo."""
    path = root / "docs" / "decisions" / "0010-bleeps-runs-the-crew-bloops-reflects.md"
    names: list[str] = []
    in_table = False
    for line in path.read_text().splitlines():
        if line.startswith("| Agent |"):
            in_table = True
            continue
        if not in_table:
            continue
        if not line.startswith("|"):
            break
        if set(line.replace("|", "").strip()) <= {"-", " "}:
            continue
        cell = line.split("|")[1].strip()
        if cell and cell.lower() != "echo":
            names.append(cell.lower())
    if not names:
        raise SystemExit("could not read the crew table in 0010")
    return names


def skill_dirs(root: Path) -> list[tuple[str, Path]]:
    found: list[tuple[str, Path]] = []
    seen: dict[str, Path] = {}
    agents = root / "agents"
    for role_dir in sorted(path for path in agents.iterdir() if path.is_dir()):
        skills = role_dir / "skills"
        if not skills.is_dir():
            continue
        for skill in sorted(path for path in skills.iterdir() if path.is_dir()):
            marker = skill / "SKILL.md"
            if not marker.exists():
                continue
            if marker.is_symlink():
                raise SystemExit(
                    f"{marker.relative_to(root)} is a symlink. Orca ignores a SKILL.md that is itself a link."
                )
            if skill.name in seen:
                raise SystemExit(f"two skills share the folder name {skill.name}")
            seen[skill.name] = skill
            text = marker.read_text()
            match = FRONTMATTER.match(text)
            if not match or not re.search(r"(?m)^name: \S", match.group(1)) or not re.search(
                r"(?m)^description: \S", match.group(1)
            ):
                raise SystemExit(f"{marker.relative_to(root)} needs name and description in frontmatter")
            found.append((skill.name, skill))
    if not found:
        raise SystemExit("no skills under agents/")
    return found


def problems(root: Path) -> list[str]:
    found: list[str] = []
    project = bleeps().load_project(root)
    try:
        runtime_choice(project)
    except SystemExit as error:
        found.append(str(error))

    expected = {"bleeps", *crew_bots(root)}
    if expected != {name for name, _purpose in BOTS}:
        found.append(f"bot table {sorted(name for name, _ in BOTS)} != crew {sorted(expected)}")
    souls = root / "bots"
    present = {path.parent.name for path in souls.glob("*/SOUL.md")} if souls.is_dir() else set()
    if present != expected:
        found.append(f"SOUL files are {sorted(present)}, expected {sorted(expected)}")
    if (souls / "echo").exists():
        found.append("Echo is a fresh worker, not a bot")
    for name in sorted(expected & present):
        text = (souls / name / "SOUL.md").read_text()
        for needle in (*SHARED_NEEDLES, *ROLE_NEEDLES[name]):
            if needle not in text:
                found.append(f"bots/{name}/SOUL.md is missing {needle!r}")

    try:
        skills = skill_dirs(root)
    except SystemExit as error:
        found.append(str(error))
        skills = []
    exposed = root / ".agents" / "skills"
    links = {path.name: path for path in exposed.iterdir()} if exposed.is_dir() else {}
    for name, skill in skills:
        link = links.pop(name, None)
        relative = os.path.relpath(skill, exposed)
        if link is None:
            found.append(f".agents/skills/{name} is missing")
            continue
        if not link.is_symlink():
            found.append(f".agents/skills/{name} must be a directory symlink, not a copy")
            continue
        target = os.readlink(link)
        if target != relative:
            found.append(f".agents/skills/{name} points at {target}, expected {relative}")
    for extra in sorted(links):
        found.append(f".agents/skills/{extra} is not a skill under agents/")

    guide = root / "docs" / "bots.md"
    if not guide.exists():
        found.append("missing docs/bots.md")
    else:
        doc = guide.read_text()
        printed = render(root, project)
        # The scout precheck path is this checkout. The guide names the flags
        # and tells you to copy the command from print, so a clone path does
        # not have to be committed.
        chip = chip_automation(root, project)
        stable = [command for command in commands(root, project) if command != chip]
        for command in stable:
            if command not in printed:
                found.append(f"print dropped {command.splitlines()[0]}")
            if command not in doc:
                found.append(f"docs/bots.md is missing {command.splitlines()[0]}")
        if chip not in printed:
            found.append("print dropped the Chip automation")
        for needle in ('--bot chip', '--runs-in new', '--name "Bleeps scout"'):
            if needle not in doc:
                found.append(f"docs/bots.md is missing {needle}")
        if "bot group create" in printed or "bot group create" in doc:
            found.append("no documented CLI creates a group")
        if "New bot or group" not in doc:
            found.append("docs/bots.md should say where a group is created")
    return found


def cmd_print(root: Path) -> int:
    project = bleeps().load_project(root)
    sys.stdout.write(render(root, project))
    return 0


def cmd_check(root: Path) -> int:
    found = problems(root)
    if found:
        print("\n".join(found), file=sys.stderr)
        return 1
    print("ok")
    return 0


def main(argv: list[str]) -> int:
    root = Path.cwd()
    if not argv or argv[0] in {"-h", "--help"}:
        print("usage: bots print | bots check", file=sys.stderr)
        return 0 if argv and argv[0] in {"-h", "--help"} else 2
    if argv[0] == "print":
        return cmd_print(root)
    if argv[0] == "check":
        return cmd_check(root)
    print(f"unknown command {argv[0]}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
