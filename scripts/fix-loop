#!/usr/bin/env python3
"""A red suite goes back to the same run. Merge still requires green.

Runs scripts/orca-verify, which is the test suite and typecheck.

Exit 0: green. Continue to Echo.
Exit 3: red, and a fix round remains. Do not stop the run. Buzz fixes
        product code. Blip fixes a wrong test. Then run this again.
Exit 2: fix_rounds is spent. Print a summary for James. Do not open a
        pull request and do not merge.
Exit 1: fix_rounds is not an integer from 0 to 20, or the state file
        is unreadable.

fix_rounds lives in orca.project.yaml. Default 2: two send-backs, and
the next red escalates. That is the old "ask James before a third pass".

State is .bleeps/fix-loop.json in the worktree. Do not commit it.
A green run deletes it. The writer of the fix does not certify it.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path

# ponytail: last 40 lines and 2000 characters per round. Upgrade path: keep
# the full log next to the state file if a summary is not enough to fix from.
TAIL_LINES = 40
TAIL_CHARS = 2000


def load_bleeps():
    path = Path(__file__).resolve().parent / "bleeps"
    loader = importlib.machinery.SourceFileLoader("bleeps_cli_fix_loop", str(path))
    spec = importlib.util.spec_from_loader("bleeps_cli_fix_loop", loader)
    if spec is None:
        raise SystemExit("fix-loop: cannot load scripts/bleeps")
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def worktree() -> Path:
    raw = os.environ.get("ORCA_WORKTREE_PATH")
    return Path(raw).resolve() if raw else Path.cwd().resolve()


def fix_rounds(project: dict[str, str]) -> int:
    raw = project.get("fix_rounds", "2")
    if not raw.isdigit():
        raise SystemExit(f"fix_rounds must be an integer 0-20, got {raw!r}")
    limit = int(raw)
    if limit > 20:
        raise SystemExit("fix_rounds must be an integer 0-20")
    return limit


def state_path(root: Path) -> Path:
    return root / ".bleeps" / "fix-loop.json"


def load_state(root: Path) -> dict:
    path = state_path(root)
    if not path.exists():
        return {"round": 0, "failures": []}
    try:
        data = json.loads(path.read_text())
    except json.JSONDecodeError as error:
        raise SystemExit(f"fix-loop: {path} is not valid JSON ({error})") from error
    if not isinstance(data, dict) or not isinstance(data.get("round"), int):
        raise SystemExit(f"fix-loop: {path} has no integer round")
    failures = data.get("failures")
    if not isinstance(failures, list):
        raise SystemExit(f"fix-loop: {path} has no failures list")
    return data


def save_state(root: Path, state: dict) -> None:
    path = state_path(root)
    path.parent.mkdir(exist_ok=True)
    path.write_text(json.dumps(state, indent=2) + "\n")


def clear_state(root: Path) -> None:
    path = state_path(root)
    if path.exists():
        path.unlink()


def tail(text: str) -> str:
    chunk = "\n".join(text.splitlines()[-TAIL_LINES:])
    if len(chunk) > TAIL_CHARS:
        chunk = chunk[-TAIL_CHARS:]
    return chunk or "(no output)"


def run_verify(root: Path) -> tuple[int, str]:
    script = Path(__file__).resolve().parent / "orca-verify"
    env = os.environ.copy()
    env["ORCA_WORKTREE_PATH"] = str(root)
    result = subprocess.run(
        ["sh", str(script)],
        cwd=root,
        env=env,
        text=True,
        capture_output=True,
    )
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode, tail(result.stdout + result.stderr)


def summary(limit: int, state: dict) -> str:
    blocks = [f"## Round {index + 1}\n{text}" for index, text in enumerate(state["failures"])]
    return (
        f"fix-loop: red, round {state['round']} of {limit}. Escalate to James.\n"
        f"The suite is still red after {limit} fix rounds. "
        "Do not open a pull request. Do not merge.\n"
        "Delete .bleeps/fix-loop.json after a fix to start the count over.\n\n"
        + "\n\n".join(blocks)
        + "\n"
    )


def main(argv: list[str]) -> int:
    if argv and argv[0] in {"-h", "--help"}:
        print("usage: fix-loop", file=sys.stderr)
        return 0
    if argv:
        print("usage: fix-loop", file=sys.stderr)
        return 2
    root = worktree()
    os.chdir(root)
    limit = fix_rounds(load_bleeps().load_project(root))
    code, output = run_verify(root)
    if code == 0:
        clear_state(root)
        print("fix-loop: green. Continue to Echo. Do not merge until Echo says Ready to ship.")
        return 0
    state = load_state(root)
    state["round"] = int(state["round"]) + 1
    state["failures"].append(output)
    save_state(root, state)
    if state["round"] > limit:
        print(summary(limit, state), end="")
        return 2
    print(
        f"fix-loop: red, round {state['round']} of {limit}. Do not stop the run.\n"
        "Buzz fixes the code. Blip fixes the test when the test itself is wrong.\n"
        "The writer does not certify the fix. Run fix-loop again after the fix.\n"
        "Do not merge while this is red."
    )
    return 3


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
