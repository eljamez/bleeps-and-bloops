#!/usr/bin/env python3
"""Linear adapter. Fetch an issue, set its workflow state, attach the pull request.

The id is a team identifier such as ENG-12, or a Linear UUID. State types
map as unstarted or backlog -> open, started -> in_progress, completed -> done.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import ticketlib

raise SystemExit(ticketlib.adapter_main("linear", sys.argv[1:]))
