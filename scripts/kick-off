#!/usr/bin/env python3
"""Beep's scaffold. Creates the spec folder. Does not write product code.

`--ticket -` reads a normalized ticket JSON from stdin. `--ticket path`
reads that file. ticket.md is then the source, the id, and the body.
Without `--ticket`, ticket.md is a stub for a GitHub issue number.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

TICKET = """# Ticket

Issue: {issue}

Fill this from the GitHub issue. Beep writes it. Buzz does not start here.
"""

SPEC = """# Spec

status: draft

## Problem

## Acceptance

Beep fills this. Status becomes approved when this is the spec to build.
"""

TASKS = """# Tasks

- [ ] Implement the spec
- [ ] Blip covers the change with tests

Beep owns this checklist. Buzz implements it.
"""

DESIGN = """# Design

The approach is the risky part. Beep writes the approach here. Buzz follows it.
"""


def ticket_markdown(raw: str, issue: str) -> str:
    try:
        ticket = json.loads(raw)
    except json.JSONDecodeError as error:
        print(f"ticket JSON is not valid: {error}", file=sys.stderr)
        raise SystemExit(2)
    labels = ", ".join(ticket.get("labels") or []) or "none"
    body = (ticket.get("body") or "").rstrip()
    return (
        "# Ticket\n\n"
        f"Source: {ticket.get('source', '')}\n"
        f"Source-Id: {ticket.get('source', '')}:{ticket.get('id', '')}\n"
        f"URL: {ticket.get('url', '')}\n"
        f"Status: {ticket.get('status', '')}\n"
        f"Labels: {labels}\n\n"
        f"# {ticket.get('title', '')}\n\n"
        f"{body}\n"
        f"\nGitHub issue: {issue}\n"
    )


def main(argv: list[str]) -> int:
    design = "--design" in argv
    ticket_raw = None
    args: list[str] = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg == "--design":
            index += 1
            continue
        if arg == "--ticket":
            if index + 1 >= len(argv):
                print("usage: kick-off <issue-number> <slug> [--design] [--ticket -|path]", file=sys.stderr)
                return 2
            source = argv[index + 1]
            if source == "-":
                ticket_raw = sys.stdin.read()
            else:
                path = Path(source)
                if not path.is_file():
                    print(f"no ticket file {source}", file=sys.stderr)
                    return 2
                ticket_raw = path.read_text()
            index += 2
            continue
        args.append(arg)
        index += 1
    if len(args) != 2 or not args[0].isdigit() or not args[1]:
        print("usage: kick-off <issue-number> <slug> [--design] [--ticket -|path]", file=sys.stderr)
        return 2
    folder = Path("specs") / f"{args[0]}-{args[1]}"
    folder.mkdir(parents=True, exist_ok=True)
    files = {
        "ticket.md": ticket_markdown(ticket_raw, args[0]) if ticket_raw is not None else TICKET.format(issue=args[0]),
        "spec.md": SPEC,
        "tasks.md": TASKS,
    }
    if design:
        files["design.md"] = DESIGN
    for name, body in files.items():
        path = folder / name
        if path.exists():
            print(f"exists {path}")
            continue
        path.write_text(body)
        print(f"wrote {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
