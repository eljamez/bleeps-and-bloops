#!/usr/bin/env python3
"""Jira adapter. Fetch an issue, transition it, comment the pull request.

Status names are matched against To Do, In Progress, and Done, then against
the status category. Credentials are the env vars named jira_email_env and
jira_token_env. The values stay out of the repo.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import ticketlib

raise SystemExit(ticketlib.adapter_main("jira", sys.argv[1:]))
