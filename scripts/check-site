#!/usr/bin/env python3
"""Fail when the public site drifts from the factory.

The site renders site/system-facts.json. This script derives the same
facts from the crew table, ticketlib, the fix loop, decision 0011, the
scout, and examples/orca.project.yaml, then compares. It also checks
that the pages actually render that file.

ponytail: label needles for ticket sources are a short map, not a
parser of the decision prose. A new source id fails until this map and
system-facts.json both name it. health_url and preview stay off the
site because bleeps does not run them yet. Commented credential keys
stay in docs/tickets.md; the site says they are env var names.
"""

from __future__ import annotations

import json
import re
import stat
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FACTS_PATH = ROOT / "site" / "system-facts.json"
DECISION_0010 = ROOT / "docs" / "decisions" / "0010-bleeps-runs-the-crew-bloops-reflects.md"
DECISION_0011 = ROOT / "docs" / "decisions" / "0011-scripts-first.md"
EXAMPLE = ROOT / "examples" / "orca.project.yaml"

# Uncommented example keys the site does not teach. They are recorded
# for later and the commands refuse or no-op.
SKIP_KEYS = {"health_url", "preview"}

# Commented keys a person still sets or reads about while using the line.
EXTRA_KEYS = {"fix_rounds", "test_unit", "test_integration", "test_e2e", "scout_provider"}

LABEL_NEEDLES = {
    "github": "GitHub",
    "github-project": "GitHub Project",
    "jira": "Jira",
    "discord": "Discord",
    "linear": "Linear",
}

BANNED = (
    "bb:kick-off",
    "game controller",
    "Kent",
    "James Hall",
    "Kody",
    "commands that run a ticket are still planned",
    "number of rounds is not chosen",
    "not the front door",
)


def read(path: Path) -> str:
    if not path.exists():
        raise SystemExit(f"missing {path.relative_to(ROOT)}")
    return path.read_text()


def crew_from_decision() -> list[str]:
    names: list[str] = []
    in_table = False
    for line in read(DECISION_0010).splitlines():
        if line.startswith("| Agent |"):
            in_table = True
            continue
        if not in_table:
            continue
        if not line.startswith("|"):
            break
        if set(line.replace("|", "").strip()) <= {"-", " "}:
            continue
        cell = line.split("|")[1].strip()
        if cell:
            names.append(cell)
    if len(names) < 2:
        raise SystemExit("could not read the crew table in 0010")
    return names


def quoted_tuple(path: Path, name: str) -> list[str]:
    match = re.search(rf"^{name} = \(([^)]*)\)", read(path), re.M)
    if not match:
        raise SystemExit(f"{path.name} has no {name} tuple")
    return re.findall(r'"([^"]+)"', match.group(1))


def get_default(path: Path, key: str) -> str:
    match = re.search(rf'project\.get\("{re.escape(key)}", "([^"]*)"\)', read(path))
    if not match:
        raise SystemExit(f"{path.name} has no default for {key}")
    return match.group(1)


def crew_scripts() -> list[str]:
    for line in read(DECISION_0011).splitlines():
        if line.startswith("Scripts in place"):
            found = re.findall(r"scripts/[a-z0-9-]+", line)
            if found:
                return found
    raise SystemExit("0011 has no scripts list")


def example_keys() -> tuple[set[str], set[str]]:
    uncommented: set[str] = set()
    commented: set[str] = set()
    for line in read(EXAMPLE).splitlines():
        stripped = line.strip()
        is_comment = stripped.startswith("#")
        raw = stripped.lstrip("#").strip()
        match = re.match(r"([a-z][a-z0-9_]*)\s*:", raw)
        if not match:
            continue
        (commented if is_comment else uncommented).add(match.group(1))
    return uncommented, commented


def derive() -> dict:
    scout = ROOT / "scripts" / "bleeps-scout"
    return {
        "crew": crew_from_decision(),
        "sources": quoted_tuple(ROOT / "scripts" / "ticketlib.py", "SOURCES"),
        "fix_rounds": int(get_default(ROOT / "scripts" / "fix-loop", "fix_rounds")),
        "scripts": crew_scripts(),
        "defaults": {
            "proactive": get_default(scout, "proactive"),
            "scout_cap": get_default(scout, "scout_cap"),
            "scout_schedule": get_default(scout, "scout_schedule"),
            "scout_time": get_default(scout, "scout_time"),
        },
    }


def required_config_keys() -> set[str]:
    uncommented, commented = example_keys()
    missing = EXTRA_KEYS - uncommented - commented
    if missing:
        raise SystemExit(f"example orca.project.yaml no longer documents {sorted(missing)}")
    return (uncommented - SKIP_KEYS) | EXTRA_KEYS


def problems(facts: dict, derived: dict) -> list[str]:
    found: list[str] = []

    def bad(message: str) -> None:
        found.append(message)

    crew = [item.get("name") for item in facts.get("crew", [])]
    if crew != derived["crew"]:
        bad(f"crew is {crew}, decision 0010 says {derived['crew']}")
    else:
        dirs = {path.name for path in (ROOT / "agents").iterdir() if (path / "ROLE.md").exists()}
        named = {name.lower() for name in crew}
        if dirs != named:
            bad(f"agent directories {sorted(dirs)} do not match the crew {sorted(named)}")
    for item in facts.get("crew", []):
        if not str(item.get("job", "")).strip():
            bad(f"{item.get('name')} has an empty job")

    got_sources = facts.get("ticketSources", [])
    got_ids = [item.get("id") for item in got_sources]
    if got_ids != derived["sources"]:
        bad(f"ticket sources are {got_ids}, ticketlib says {derived['sources']}")
    else:
        for item in got_sources:
            needle = LABEL_NEEDLES.get(item["id"])
            if needle is None:
                bad(f"add a label needle for {item['id']} in scripts/check-site")
            elif needle not in item.get("label", ""):
                bad(f"{item['id']} label {item.get('label')!r} must contain {needle!r}")
    if facts.get("githubRequired") is not True:
        bad("githubRequired must be true")
    if "GitHub is always allowed." not in read(ROOT / "scripts" / "ticketlib.py"):
        bad("ticketlib no longer says GitHub is always allowed")

    if facts.get("fixRounds") != derived["fix_rounds"]:
        bad(f"fixRounds is {facts.get('fixRounds')}, scripts/fix-loop defaults to {derived['fix_rounds']}")

    got_scripts = [item.get("path") for item in facts.get("scripts", [])]
    if got_scripts != derived["scripts"]:
        bad(f"scripts are {got_scripts}, decision 0011 says {derived['scripts']}")
    else:
        for item in facts["scripts"]:
            path = ROOT / item["path"]
            if not path.exists():
                bad(f"missing {item['path']}")
            elif not path.stat().st_mode & stat.S_IXUSR:
                bad(f"{item['path']} is not executable")
            if not str(item.get("who", "")).strip():
                bad(f"{item['path']} has an empty who")

    if facts.get("defaults") != derived["defaults"]:
        bad(f"defaults are {facts.get('defaults')}, scripts say {derived['defaults']}")

    config = set(facts.get("configKeys", []))
    required = required_config_keys()
    if config != required:
        bad(
            "config keys drifted\n"
            f"  site only {sorted(config - required)}\n"
            f"  system only {sorted(required - config)}"
        )

    pipeline = json.dumps(facts.get("pipeline", []))
    for token in ("{{sources}}", "{{fixRounds}}", "scripts/fix-loop", "scripts/merge-pr", "Ready to ship"):
        if token not in pipeline:
            bad(f"pipeline is missing {token}")
    for name in derived["crew"]:
        if name not in pipeline:
            bad(f"pipeline does not name {name}")
    return found


def page_problems() -> list[str]:
    found: list[str] = []
    app = ROOT / "site" / "app"

    def need(path: Path, needle: str) -> None:
        text = read(path)
        if needle not in text:
            found.append(f"{path.relative_to(ROOT)} does not render {needle}")

    home = app / "page.tsx"
    using = app / "using-bleeps" / "page.tsx"
    shell = app / "shell.tsx"
    def renders_sources(path: Path) -> None:
        text = read(path)
        if "system.ticketSources" not in text and "sourceList(" not in text:
            found.append(f"{path.relative_to(ROOT)} does not render ticket sources")

    need(home, "fill(")
    need(home, "system.pipeline")
    renders_sources(home)
    need(using, "system.crew")
    need(using, "system.scripts")
    need(using, "system.fixRounds")
    renders_sources(using)
    need(using, "system.defaults")
    need(shell, "system.fixRounds")
    need(shell, "system.configKeys")
    for name in ("new", "existing"):
        page = app / "start" / name / "page.tsx"
        renders_sources(page)
        need(page, "ConfigKeys")
        if "GitHub is required" not in read(page):
            found.append(f"start/{name} must say GitHub is required")

    number = re.compile(r"defaults? to \d+|\(default \d+\)")
    for path in app.rglob("*.tsx"):
        text = path.read_text()
        for phrase in BANNED:
            if phrase in text:
                found.append(f"{path.relative_to(ROOT)} contains {phrase!r}")
        if re.search(r"\bJames\b", text):
            found.append(f"{path.relative_to(ROOT)} names James; the site speaks to the owner as you")
        if number.search(text):
            found.append(f"{path.relative_to(ROOT)} hardcodes a default; read it from system-facts.json")
    facts_text = read(FACTS_PATH)
    for phrase in BANNED:
        if phrase in facts_text:
            found.append(f"system-facts.json contains {phrase!r}")
    if "issueCommand" not in read(using):
        found.append("the day-to-day page no longer names issueCommand")
    if not (ROOT / "agents/bloops/skills/update/SKILL.md").exists():
        found.append("missing agents/bloops/skills/update/SKILL.md")
    if "check-site" not in read(ROOT / "scripts/bloops-reflect"):
        found.append("bloops-reflect does not run check-site")
    if "check-site" not in read(ROOT / "agents/bloops/skills/merge/SKILL.md"):
        found.append("the merge skill does not require check-site")
    if "check-site" not in read(ROOT / "agents/echo/skills/verify/SKILL.md"):
        found.append("the verify skill does not require check-site")
    return found


def main() -> int:
    facts = json.loads(read(FACTS_PATH))
    derived = derive()
    found = problems(facts, derived) + page_problems()
    if "--self-check" in sys.argv:
        if found:
            print("\n".join(found), file=sys.stderr)
            return 1
        broken = json.loads(json.dumps(facts))
        broken["crew"] = [item for item in broken["crew"] if item["name"] != "Bloops"]
        if not any("crew" in item for item in problems(broken, derived)):
            print("self-check did not catch a missing crew member", file=sys.stderr)
            return 1
        broken = json.loads(json.dumps(facts))
        broken["fixRounds"] = derived["fix_rounds"] + 1
        if not problems(broken, derived):
            print("self-check did not catch a fixRounds drift", file=sys.stderr)
            return 1
        print("ok")
        return 0
    if found:
        print("\n".join(found), file=sys.stderr)
        return 1
    print("ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
